#include <iostream>
#include <vector>
#include <string>
#include <cmath>

using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    
    int b = n - k; // Number of alternating blocks
    
    // Try both starting choices: 0 or 1
    for (int start = 0; start <= 1; ++start) {
        int z, o;
        if (start == 0) {
            z = (b + 1) / 2;
            o = b / 2;
        } else {
            z = b / 2;
            o = (b + 1) / 2;
        }
        
        // Generate possible valid combinations of (n0, n1)
        vector<pair<int, int>> choices;
        if (n % 2 == 0) {
            choices.push_back({n / 2, n / 2});
        } else {
            choices.push_back({(n + 1) / 2, n / 2});
            choices.push_back({n / 2, (n + 1) / 2});
        }
        
        for (auto& choice : choices) {
            int n0 = choice.first;
            int n1 = choice.second;
            
            // Check boundary requirements
            if (z == 0 && n0 != 0) continue;
            if (o == 0 && n1 != 0) continue;
            if (z > 0 && n0 < z) continue;
            if (o > 0 && n1 < o) continue;
            
            // Distribute remaining characters to the first available block
            int first_z_size = (z > 0) ? (n0 - z + 1) : 0;
            int first_o_size = (o > 0) ? (n1 - o + 1) : 0;
            
            string result = "";
            int curr = start;
            bool first_z = true, first_o = true;
            
            for (int i = 0; i < b; ++i) {
                if (curr == 0) {
                    if (first_z) {
                        result += string(first_z_size, '0');
                        first_z = false;
                    } else {
                        result += '0';
                    }
                    curr = 1;
                } else {
                    if (first_o) {
                        result += string(first_o_size, '1');
                        first_o = false;
                    } else {
                        result += '1';
                    }
                    curr = 0;
                }
            }
            cout << result << "\n";
            return;
        }
    }
    cout << -1 << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
